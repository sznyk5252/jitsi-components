{
  "name": "jitsi-component-layout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/jitsi-component-layout.js",
  "module": "./dist-lib/jitsi-component-layout.js",
  "types": "./dist-lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/jitsi-component-layout.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
